# Always use capital "On" for RewriteEngine for best compatibility
RewriteEngine On

# ----------------------------------------------------------------------
# SECTION 1: Force HTTPS and canonical domain (naleko.com)
# ----------------------------------------------------------------------
# If the host starts with "www." OR if HTTPS is "off"
RewriteCond %{HTTP_HOST} ^www\.naleko\.com [NC,OR]
RewriteCond %{HTTPS} off
# Then redirect everything to the correct, secure, non-www version
RewriteRule ^(.*)$ https://naleko.com/$1 [L,R=301]




# ----------------------------------------------------------------------
# SECTION 2: Internal Clean URL Rewrites
# ----------------------------------------------------------------------
# This section only runs if the rules in Section 1 did not apply.
# It rewrites pretty URLs to the actual files internally.
RewriteRule ^contact-us/$ /Web-Pages/ContactUs.html [L]
RewriteRule ^about-us/$ /Web-Pages/WhoWeAre.html [L]
RewriteRule ^what-we-do/$ /Web-Pages/WhatWeDo.html [L]
RewriteRule ^who-we-serve/$ /Web-Pages/WhoWeServe.html [L]
RewriteRule ^corporate-training/$ /Web-Pages/CorpTraining.html [L]
RewriteRule ^naleko-academy/$ /Web-Pages/Academy.html [L]
RewriteRule ^girls-in-tech/$ /Web-Pages/GirlsInTech.html [L]
RewriteRule ^events/$ /Web-Pages/Events.html [L]
RewriteRule ^partner-with-us/$ /Web-Pages/PartnerWithUs.html [L]
RewriteRule ^book-a-demo/$ /Web-Pages/bookADemo.html [L]
RewriteRule ^success-callback-hidden/$ /Web-Pages/SuccessCallBack.html [L]
RewriteRule ^what-we-know/?$ /index.html [L]
RewriteRule ^naleko-campaigns/$ /Web-Pages/CampaignDraft.html [L]
RewriteRule ^training/$ /Web-Pages/CorporateLearning.html [L]




# ----------------------------------------------------------------------
# Testing Environment (Hidden Preview Pages)
# Not linked anywhere on the site.
# ----------------------------------------------------------------------


RewriteRule ^testing/training/$ /Web-Pages/CorporateLearning.html [L]
RewriteRule ^testing/about-us/$ /Web-Pages/WhoWeAre-Test.html [L]
RewriteRule ^testing/what-we-do/$ /Web-Pages/WhatWeDo-Test.html [L]
RewriteRule ^testing/who-we-serve/$ /Web-Pages/WhoWeServe-Test.html [L]
RewriteRule ^testing/contact-us/$ /Web-Pages/ContactUs-Test.html [L]
RewriteRule ^testing/corporate-training/$ /Web-Pages/CorpTraining-Test.html [L]
RewriteRule ^testing/naleko-academy/$ /Web-Pages/Academy-Test.html [L]
RewriteRule ^testing/girls-in-tech/$ /Web-Pages/GirlsInTech-Test.html [L]
RewriteRule ^testing/events/$ /Web-Pages/Events-Test.html [L]
RewriteRule ^testing/partner-with-us/$ /Web-Pages/PartnerWithUs-Test.html [L]
RewriteRule ^testing/book-a-demo/$ /Web-Pages/BookADemo-Test.html [L]
RewriteRule ^testing/success-callback-hidden/$ /Web-Pages/SuccessCallBack-Test.html [L]
RewriteRule ^testing/naleko-campaigns/$ /Web-Pages/CampaignDraft-Test.html [L]

RewriteRule ^flagship/$ /Web-Pages/WhoWeAre.html#flags [L,NE]


# This section only runs if the rules in Section 1 did not apply.
# It rewrites pretty URLs to the actual files internally.
RewriteRule ^Contact-us/$ /Web-Pages/Testing/Web-Pages/ContactUsV2.html [L]
RewriteRule ^About-us/$ /Web-Pages/Testing/Web-Pages/WhoWeAreV2.html [L]
RewriteRule ^What-we-do/$ /Web-Pages/Testing/Web-Pages/WhatWeDoV2.html [L]
RewriteRule ^Who-we-serve/$ /Web-Pages/Testing/Web-Pages/WhoWeServeV2.html [L]
RewriteRule ^Training/$ /Web-Pages/Testing/Web-Pages/CorporateLearningV2.html [L]

RewriteRule ^Girls-in-tech/$ /Web-Pages/Testing/Web-Pages/GirlsInTechV2.html [L]
RewriteRule ^Events/$ /Web-Pages/Testing/Web-Pages/EventsV2.html [L]
RewriteRule ^Partner-with-us/$ /Web-Pages/Testing/Web-Pages/PartnerWithUsV2.html [L]
RewriteRule ^Book-a-demo/$ /Web-Pages/Testing/Web-Pages/BookADemoV2.html [L]

RewriteRule ^what-we-know/?$ /indexV2.html [L]
RewriteRule ^Naleko-campaigns/$ /Web-Pages/CampaignV2.html [L]
