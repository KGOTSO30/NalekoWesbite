# Always use capital "On" for RewriteEngine for best compatibility
RewriteEngine On

# ----------------------------------------------------------------------
# SECTION 1: Force HTTPS and canonical domain (naleko.com)
# ----------------------------------------------------------------------
# If the host starts with "www." OR if HTTPS is "off"
RewriteCond %{HTTP_HOST} ^www\.naleko\.com [NC,OR]
RewriteCond %{HTTPS} off
# Then redirect everything to the correct, secure, non-www version
RewriteRule ^(.*)$ https://naleko.com/$1 [L,R=301]


# This section only runs if the rules in Section 1 did not apply.
# It rewrites pretty URLs to the actual files internally.
RewriteRule ^Contact-us/$ /Web-Pages/Testing/Web-Pages/ContactUsV2.html [NC,L]
RewriteRule ^About-us/$ /Web-Pages/Testing/Web-Pages/WhoWeAreV2.html [NC,L]
RewriteRule ^What-we-do/$ /Web-Pages/Testing/Web-Pages/WhatWeDoV2.html [NC,L]
RewriteRule ^Who-we-serve/$ /Web-Pages/Testing/Web-Pages/WhoWeServeV2.html [NC,L]
RewriteRule ^Training/$ /Web-Pages/Testing/Web-Pages/CorporateLearningV2.html [NC,L]

RewriteRule ^Girls-in-tech/$ /Web-Pages/Testing/Web-Pages/GirlsInTechV2.html [NC,L]
RewriteRule ^Events/$ /Web-Pages/Testing/Web-Pages/EventsV2.html [NC,L]
RewriteRule ^Partner-with-us/$ /Web-Pages/Testing/Web-Pages/PartnerWithUsV2.html [NC,L]
RewriteRule ^Book-a-demo/$ /Web-Pages/Testing/Web-Pages/BookADemoV2.html [NC,L]
RewriteRule ^Talent/$ /Web-Pages/Testing/Web-Pages/Talent.html [NC,L]
RewriteRule ^Thank-You/$ /Web-Pages/TalentThankYouPage-Test.html [NC,L]


RewriteRule ^what-we-know/?$ /indexV2.html [NC,L]
RewriteRule ^Naleko-campaigns/$ /Web-Pages/CampaignV2.html [NC,L]
