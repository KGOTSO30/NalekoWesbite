# Server Configuration
PORT=3001
ALLOWED_ORIGINS=https://naleko.com,https://www.naleko.com,http://127.0.0.1:5503,http://localhost:5503,http://127.0.0.1:5500,http://localhost:5500

# Salesforce Connected App Credentials
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_REDIRECT_URI=http://localhost:3001/oauth/callback

# Obtained once via /login -> /oauth/callback so tokens auto-refresh in production
SALESFORCE_REFRESH_TOKEN=
